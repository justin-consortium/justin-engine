{
  "name": "@just-in/engine",
  "version": "0.1.0",
  "description": "A TypeScript-first event-driven engine for adaptive digital health interventions (JITAI).",
  "license": "BSD-3-Clause",
  "author": "MIACollaborative",
  "packageManager": "yarn@4.13.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/justin-consortium/justin-engine"
  },
  "keywords": [
    "jitai",
    "justin",
    "just-in time",
    "digital intervention",
    "adaptive intervention",
    "rules-engine",
    "decision rule",
    "event engine"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js",
      "require": "./dist/testing/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "yarn build",
    "clean": "rm -rf dist",
    "docs": "typedoc",
    "start": "node dist/index.js",
    "test:unit": "yarn build && jest --config=jest.unit.config.js -i --verbose --passWithNoTests --runInBand --detectOpenHandles",
    "test:integration": "yarn build && jest --config=jest.integration.config.js --verbose --passWithNoTests --runInBand --detectOpenHandles",
    "test:e2e": "yarn build && jest --config=jest.e2e.config.js --verbose --passWithNoTests --runInBand --detectOpenHandles",
    "test": "yarn test:unit && yarn test:integration && yarn test:e2e --coverage"
  },
  "peerDependencies": {
    "@just-in/core": "*"
  },
  "peerDependenciesMeta": {
    "@just-in/core": {
      "optional": false
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.9.0",
    "@types/sinon": "^17.0.3",
    "@typescript-eslint/eslint-plugin": "^8.11.0",
    "@typescript-eslint/parser": "^8.11.0",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "globals": "^15.11.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.1.4",
    "prettier": "^3.3.3",
    "sinon": "^19.0.2",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typedoc": "^0.28.7",
    "typedoc-plugin-markdown": "^4.7.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.11.0"
  }
}
